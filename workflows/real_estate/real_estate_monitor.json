{
  "name": "Real Estate Transaction Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 6 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "schedule-trigger",
      "name": "Daily Schedule (06:30)"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "current_month",
              "value": "={{ $now.format('YYYYMM') }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        220,
        0
      ],
      "id": "format-yyyymm",
      "name": "Format YYYYMM"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://consigliere_api:8000/agent/real_estate/monitor/fetch",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "month",
              "value": "={{ $node[\"Format YYYYMM\"].json[\"current_month\"] }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "id": "http-request",
      "name": "Call Consigliere API"
    }
  ],
  "connections": {
    "Daily Schedule (06:30)": {
      "main": [
        [
          {
            "node": "Format YYYYMM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format YYYYMM": {
      "main": [
        [
          {
            "node": "Call Consigliere API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}